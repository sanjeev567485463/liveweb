APP_NAME="Apna Study Centre"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://apnastudycentre.com
ASSET_URL=
APP_KEY=
APP_TIMEZONE=Asia/Kolkata
APP_VERSION=2.1

LOG_CHANNEL=stack
LOG_LEVEL=warning

# Generate only if API/mobile auth is used.
JWT_SECRET=
JWT_TTL=43200

# Database
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=your_database_name
DB_USERNAME=your_database_user
DB_PASSWORD=

# Cache / Session / Queue
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=true

# Mail
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=your_email@example.com
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=your_email@example.com
MAIL_FROM_NAME="APNA STUDY CENTRE"

# Social Login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT="${APP_URL}/google/callback"
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT="${APP_URL}/facebook/callback"

# Firebase
FIREBASE_PROJECT=app
FIREBASE_AUTH_TENANT_ID=
FIREBASE_DATABASE_URL=
FIREBASE_DYNAMIC_LINKS_DEFAULT_DOMAIN=
FIREBASE_STORAGE_DEFAULT_BUCKET=
FIREBASE_CACHE_STORE=file
FIREBASE_HTTP_LOG_CHANNEL=
FIREBASE_HTTP_DEBUG_LOG_CHANNEL=
FIREBASE_HTTP_CLIENT_PROXY=
FIREBASE_HTTP_CLIENT_TIMEOUT=
# Keep the Firebase service account JSON outside the public web root.

# Storage / CDN
FILESYSTEM_DRIVER=local
FILESYSTEM_CLOUD=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
MINIO_KEY=
MINIO_SECRET=
MINIO_REGION=
MINIO_BUCKET=
MINIO_ENDPOINT=

# Live classes / meetings
BBB_SECURITY_SALT=
BBB_SERVER_BASE_URL=
ZOOM_CLIENT_KEY=
ZOOM_CLIENT_SECRET=
ZOOM_ACCOUNT_ID=

# OpenAI
OPENAI_API_KEY=
OPENAI_ORGANIZATION=
OPENAI_REQUEST_TIMEOUT=30

# Messaging / SMS
VONAGE_KEY=
VONAGE_SECRET=
VONAGE_SIGNATURE_SECRET=
VONAGE_PRIVATE_KEY=
VONAGE_APPLICATION_ID=
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_NUMBER=

# Payment gateways: fill only the gateways you actually enable.
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_MODE=live
PAYPAL_CURRENCY=USD
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_PAYMENT_URL=
MERCHANT_EMAIL=
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_SALT=
PAYTR_MERCHANT_KEY=
PAYTR_BASE_URI=https://www.paytr.com
PAYTR_TIMEOUT=60
PAYTR_SUCCESS_URL=
PAYTR_FAIL_URL=
PAYTR_TEST_MODE=false
paytabs_profile_id=
paytabs_server_key=
paytabs_currency=
paytabs_region=
paytabs_ipn_callback=
clickpay_profile_id=
clickpay_server_key=
clickpay_currency=
